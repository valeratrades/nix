+static bool is_bare_de_number(const struct pl *pl)
+{
+	size_t i = pl->l && pl->p[0] == '+';
+
+	if (pl->l < i + 3 || pl->p[i] != '4' || pl->p[i + 1] != '9')
+		return false;
+
+	for (i += 2; i < pl->l; i++) {
+		if (!isdigit((unsigned char)pl->p[i]))
+			return false;
+	}
+
+	return true;
+}
