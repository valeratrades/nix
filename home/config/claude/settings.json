{
  "env": {
    "SSH_ASKPASS_REQUIRE": "never",
    "SUDO_ASKPASS": "/run/current-system/sw/bin/false",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_ASKPASS": "/run/current-system/sw/bin/false",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Glob",
      "Grep",
      "Agent",
      "Skill"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no_host_route_hijack.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/auto_allow.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env fish $HOME/.claude/hooks/notify.fish question"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env fish $HOME/.claude/hooks/notify.fish response"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree_create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/worktree_remove.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/limits.sh"
  },
  "enabledPlugins": {
    "code-review@claude-code-plugins": true,
    "codex@codex-plugin-cc": true,
    "feature-dev@claude-code-plugins": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true,
    "impeccable@impeccable": true,
    "plugin-dev@plugin-dev-fork": true,
    "ponytail@ponytail": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": false
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "autoCompactWindow": 1000000,
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "crossSessionInbound": "accept",
  "thinking": {
    "display": "summarized"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  }
}
